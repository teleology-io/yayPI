{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yaypi.dev/schemas/root.schema.json",
  "title": "yayPi Root Config",
  "description": "The top-level yaypi.yaml configuration file. Defines the project, server, databases, auth, policy engine, plugins, and included file globs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version.",
      "examples": ["1"]
    },
    "project": { "$ref": "#/$defs/ProjectConfig" },
    "server": { "$ref": "#/$defs/ServerConfig" },
    "databases": {
      "type": "array",
      "description": "Database connection configurations.",
      "items": { "$ref": "#/$defs/DBConfig" }
    },
    "auth": { "$ref": "#/$defs/AuthConfig" },
    "policy": { "$ref": "#/$defs/PolicyConfig" },
    "auto_migrate": {
      "type": "boolean",
      "description": "Run database migrations automatically on startup.",
      "default": false
    },
    "plugins": {
      "type": "array",
      "description": "Plugin configurations. Plugins provide custom handlers, hooks, and middleware.",
      "items": { "$ref": "#/$defs/PluginConfig" }
    },
    "include": {
      "type": "array",
      "description": "Glob patterns for YAML files to include (entities, endpoints, jobs, seeds, emails, webhooks, auth, policies).",
      "items": { "type": "string" },
      "examples": [["entities/**/*.yaml", "endpoints/**/*.yaml", "jobs/**/*.yaml"]]
    },
    "spec": {
      "type": "array",
      "description": "OpenAPI spec definitions. Each spec is a separate API documentation artifact.",
      "items": { "$ref": "#/$defs/SpecConfig" }
    },
    "log": { "$ref": "#/$defs/LogConfig" },
    "metrics": { "$ref": "#/$defs/MetricsConfig" },
    "smtp": { "$ref": "#/$defs/SMTPConfig" },
    "outbox": { "$ref": "#/$defs/OutboxConfig" },
    "cron": { "$ref": "#/$defs/CronConfig" },
    "audit": { "$ref": "#/$defs/AuditConfig" }
  },
  "$defs": {
    "ProjectConfig": {
      "type": "object",
      "description": "Project-level metadata.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name.",
          "examples": ["my-api", "acme-backend"]
        },
        "base_url": {
          "type": "string",
          "description": "Base URL of the API, used in OpenAPI specs.",
          "examples": ["https://api.example.com", "http://localhost:8080"]
        }
      }
    },
    "ServerConfig": {
      "type": "object",
      "description": "HTTP server settings.",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "description": "Port to listen on.",
          "default": 8080,
          "minimum": 1,
          "maximum": 65535,
          "examples": [8080, 3000, 9090]
        },
        "read_timeout": {
          "type": "string",
          "description": "Maximum time to read the full request including body.",
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$",
          "examples": ["15s", "30s"]
        },
        "write_timeout": {
          "type": "string",
          "description": "Maximum time to write the full response.",
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$",
          "examples": ["15s", "30s"]
        },
        "shutdown_timeout": {
          "type": "string",
          "description": "Graceful shutdown timeout on SIGTERM.",
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$",
          "examples": ["30s", "1m"]
        },
        "max_request_body_size": {
          "type": "string",
          "description": "Maximum allowed request body size.",
          "examples": ["1MB", "10MB", "32MB"]
        },
        "max_header_bytes": {
          "type": "string",
          "description": "Maximum allowed request header size.",
          "examples": ["1MB", "4KB"]
        },
        "allowed_origins": {
          "type": "array",
          "description": "CORS allowed origins. Use '*' to allow all. \"*\" allows any origin but never with credentials; credentials are only allowed for listed origins.",
          "items": { "type": "string" },
          "examples": [["https://app.example.com", "https://admin.example.com"]]
        },
        "tls": { "$ref": "#/$defs/TLSConfig" },
        "health": { "$ref": "#/$defs/HealthConfig" },
        "rate_limit": { "$ref": "#/$defs/RateLimitConfig" },
        "read_header_timeout": {
          "type": "string",
          "description": "Max time to read request headers (slowloris protection). Duration, e.g. 30s, 5m.",
          "default": "10s"
        },
        "idle_timeout": {
          "type": "string",
          "description": "Keep-alive idle timeout. Duration, e.g. 30s, 5m.",
          "default": "120s"
        },
        "request_timeout": {
          "type": "string",
          "description": "Deadline for each request context, including its queries; exceeding it returns 504. Default: write_timeout. Duration, e.g. 30s, 5m."
        },
        "drain_delay": {
          "type": "string",
          "description": "After SIGTERM, keep serving this long while /ready reports draining so load balancers move traffic away (e.g. 5s on Kubernetes). Duration, e.g. 30s, 5m."
        },
        "trusted_proxies": {
          "type": "array",
          "description": "CIDRs/IPs of reverse proxies whose X-Forwarded-For / X-Real-IP are trusted for the client IP. Empty = use the TCP peer address.",
          "items": { "type": "string" }
        },
        "cors": { "$ref": "#/$defs/CORSConfig" },
        "strict_startup": {
          "type": "boolean",
          "description": "Fail startup when a subsystem is degraded (cron, OpenAPI, email without SMTP) instead of warning.",
          "default": true
        },
        "security_headers": {
          "type": "boolean",
          "description": "Add nosniff, frame-deny, no-referrer and CSP headers.",
          "default": true
        },
        "hsts_max_age": {
          "type": "integer",
          "description": "Seconds for Strict-Transport-Security; set (e.g. 31536000) when served only over HTTPS. 0 = off.",
          "default": 0
        },
        "idempotency_ttl": {
          "type": "string",
          "description": "How long Idempotency-Key responses are replayed.",
          "default": "24h"
        }
      }
    },
    "TLSConfig": {
      "type": "object",
      "description": "TLS certificate configuration.",
      "required": ["cert_file", "key_file"],
      "additionalProperties": false,
      "properties": {
        "cert_file": {
          "type": "string",
          "description": "Path to the TLS certificate file.",
          "examples": ["/etc/ssl/certs/server.crt"]
        },
        "key_file": {
          "type": "string",
          "description": "Path to the TLS private key file.",
          "examples": ["/etc/ssl/private/server.key"]
        }
      }
    },
    "HealthConfig": {
      "type": "object",
      "description": "Health and readiness endpoint configuration.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable health and readiness endpoints.",
          "default": false
        },
        "path": {
          "type": "string",
          "description": "Liveness probe path. Returns 200 if the process is running.",
          "default": "/health",
          "examples": ["/health", "/healthz"]
        },
        "readiness_path": {
          "type": "string",
          "description": "Readiness probe path. Returns 200 if all databases are reachable, 503 otherwise.",
          "default": "/ready",
          "examples": ["/ready", "/readyz"]
        }
      }
    },
    "RateLimitConfig": {
      "type": "object",
      "description": "Global rate limiting settings. Can be overridden per endpoint.",
      "additionalProperties": false,
      "properties": {
        "requests_per_minute": {
          "type": "integer",
          "description": "Maximum requests allowed per minute.",
          "minimum": 1,
          "examples": [120, 60]
        },
        "burst": {
          "type": "integer",
          "description": "Maximum burst size above the base rate.",
          "minimum": 0,
          "examples": [20, 10]
        },
        "key_by": {
          "type": "string",
          "description": "Key used to partition rate limit counters.",
          "enum": ["ip", "user", "api_key"],
          "default": "ip"
        }
      }
    },
    "DBConfig": {
      "type": "object",
      "description": "A database connection.",
      "required": ["name", "driver", "dsn"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Connection name referenced by entities and other config.",
          "examples": ["primary", "readonly", "analytics"]
        },
        "driver": {
          "type": "string",
          "description": "Database driver.",
          "enum": ["postgres", "mysql", "sqlite3"]
        },
        "dsn": {
          "type": "string",
          "description": "Data source name / connection string. Supports ${ENV_VAR} substitution.",
          "examples": ["postgres://${DB_USER}:${DB_PASS}@${DB_HOST}:5432/${DB_NAME}?sslmode=require", "${DATABASE_URL}"]
        },
        "max_open_conns": {
          "type": "integer",
          "description": "Max open connections (default 25).",
          "minimum": 1,
          "default": 25,
          "examples": [25, 100]
        },
        "max_idle_conns": {
          "type": "integer",
          "description": "Maximum number of idle connections.",
          "minimum": 0,
          "default": 5,
          "examples": [5, 10]
        },
        "conn_max_lifetime": {
          "type": "string",
          "description": "Maximum lifetime of a connection.",
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$",
          "examples": ["5m", "30m", "1h"]
        },
        "default": {
          "type": "boolean",
          "description": "Mark this as the default database for entities that don't specify one.",
          "default": false
        },
        "read_only": {
          "type": "boolean",
          "description": "Restrict this connection to read-only queries.",
          "default": false
        },
        "schema": {
          "type": "string",
          "description": "Default schema/search_path for PostgreSQL connections.",
          "examples": ["public", "app"]
        },
        "conn_max_idle_time": {
          "type": "string",
          "description": "Close connections idle this long. Duration, e.g. 30s, 5m.",
          "default": "5m"
        }
      }
    },
    "AuthConfig": {
      "type": "object",
      "description": "JWT and API key authentication settings.",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "Auth provider identifier.",
          "examples": ["local"]
        },
        "secret": {
          "type": "string",
          "description": "HMAC key for HS* algorithms; at least 32 bytes. Use ${ENV_VAR}.",
          "examples": ["${JWT_SECRET}"]
        },
        "expiry": {
          "type": "string",
          "description": "Access token lifetime. Default: 15m with refresh tokens enabled, otherwise 1h.",
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h|d)$",
          "default": "15m",
          "examples": ["15m", "1h", "24h"]
        },
        "algorithm": {
          "type": "string",
          "description": "JWT signing algorithm.",
          "enum": ["HS256", "HS384", "HS512", "RS256", "RS384", "RS512", "ES256", "ES384", "ES512"],
          "default": "HS256"
        },
        "reject_algorithms": {
          "type": "array",
          "description": "Algorithms to explicitly reject in incoming tokens (defense against algorithm confusion attacks).",
          "items": { "type": "string" },
          "examples": [["none", "RS256"]]
        },
        "api_keys": { "$ref": "#/$defs/APIKeyConfig" },
        "private_key_file": {
          "type": "string",
          "description": "PEM private key for RS*/ES* signing."
        },
        "public_key_file": {
          "type": "string",
          "description": "PEM public key for RS*/ES* verification (derived from the private key if unset). The auth endpoints publish it at <base>/auth/.well-known/jwks.json."
        },
        "key_id": {
          "type": "string",
          "description": "\"kid\" header and JWKS key id."
        },
        "issuer": {
          "type": "string",
          "description": "\"iss\" claim. Issued as project.name by default; verified on every request when set."
        },
        "audience": {
          "type": "string",
          "description": "\"aud\" claim, verified on every request when set."
        },
        "revocation_check": {
          "type": "boolean",
          "description": "Re-read the user on each authenticated request so deletion, role changes, logout-all and password resets apply immediately (one indexed query per request).",
          "default": false
        }
      }
    },
    "APIKeyConfig": {
      "type": "object",
      "description": "API key authentication. Keys can be static (inline) or DB-backed (entity lookup).",
      "additionalProperties": false,
      "properties": {
        "header": {
          "type": "string",
          "description": "Request header name for the API key.",
          "default": "X-API-Key",
          "examples": ["X-API-Key", "Authorization"]
        },
        "query_param": {
          "type": "string",
          "description": "Query parameter name to also accept the API key from (e.g. ?api_key=...).",
          "examples": ["api_key", "token"]
        },
        "keys": {
          "type": "array",
          "description": "Static API keys. Use for server-to-server integrations where keys are managed in config.",
          "items": { "$ref": "#/$defs/StaticAPIKey" }
        },
        "entity": {
          "type": "string",
          "description": "Entity name for DB-backed API key lookup. Used when 'keys' is empty.",
          "examples": ["ApiKey"]
        },
        "key_field": {
          "type": "string",
          "description": "Entity field holding the key value.",
          "default": "token",
          "examples": ["token", "key_hash"]
        },
        "role_field": {
          "type": "string",
          "description": "Entity field holding the role to inject into the authenticated subject.",
          "default": "role",
          "examples": ["role"]
        },
        "subject_field": {
          "type": "string",
          "description": "Column used as the caller id (default: user_id if present, else the primary key)."
        },
        "key_hash": {
          "type": "string",
          "description": "How the key column is stored. sha256 (default) stores the hex digest from `yaypi apikey generate`; plain is legacy.",
          "enum": ["sha256", "plain"],
          "default": "sha256"
        }
      }
    },
    "StaticAPIKey": {
      "type": "object",
      "description": "A single static API key entry.",
      "required": ["key", "role"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "description": "The API key value. Supports ${ENV_VAR} substitution.",
          "examples": ["${INTERNAL_API_KEY}"]
        },
        "role": {
          "type": "string",
          "description": "Role injected into the subject when this key is used.",
          "examples": ["service", "admin", "readonly"]
        },
        "name": {
          "type": "string",
          "description": "Caller id for this key (default apikey:<index>)."
        }
      }
    },
    "PolicyConfig": {
      "type": "object",
      "description": "RBAC policy engine settings.",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "description": "Policy engine to use.",
          "enum": ["casbin"],
          "examples": ["casbin"]
        },
        "model": {
          "type": "string",
          "description": "Path to the Casbin model file.",
          "examples": ["policy/model.conf"]
        },
        "adapter": {
          "type": "string",
          "description": "Casbin adapter. Only file is supported; anything else fails startup.",
          "enum": ["file"],
          "default": "file"
        },
        "adapter_table": {
          "type": "string",
          "description": "Table name for DB-backed Casbin adapter.",
          "examples": ["casbin_rules"]
        }
      }
    },
    "PluginConfig": {
      "type": "object",
      "description": "A plugin configuration entry.",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Plugin name used to reference it in hooks and middleware.",
          "examples": ["myPlugin", "auditLogger"]
        },
        "path": {
          "type": "string",
          "description": "Path to the plugin .so file (for external plugins).",
          "examples": ["./plugins/audit.so"]
        },
        "checksum": {
          "type": "string",
          "description": "SHA256 checksum of the plugin file for integrity verification.",
          "examples": ["sha256:abc123..."]
        },
        "config": {
          "type": "object",
          "description": "Arbitrary plugin-specific configuration.",
          "additionalProperties": true
        }
      }
    },
    "SpecConfig": {
      "type": "object",
      "description": "An OpenAPI spec definition.",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Spec name. Used to filter endpoints via endpoint.specs.names.",
          "examples": ["public", "admin", "internal"]
        },
        "title": {
          "type": "string",
          "description": "OpenAPI info.title.",
          "examples": ["My API", "Admin API"]
        },
        "description": {
          "type": "string",
          "description": "OpenAPI info.description."
        },
        "version": {
          "type": "string",
          "description": "OpenAPI info.version.",
          "examples": ["1.0.0", "2.1.0"]
        },
        "servers": {
          "type": "array",
          "description": "OpenAPI servers list.",
          "items": { "$ref": "#/$defs/SpecServer" }
        }
      }
    },
    "SpecServer": {
      "type": "object",
      "description": "A server entry in an OpenAPI spec.",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "Server URL.",
          "examples": ["https://api.example.com", "http://localhost:8080"]
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of this server.",
          "examples": ["Production", "Local development"]
        }
      }
    },
    "LogConfig": {
      "type": "object",
      "description": "Process logging.",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "description": "Minimum log level.",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info"
        },
        "format": {
          "type": "string",
          "description": "json (one object per line) or console. Default: console on a terminal, json otherwise.",
          "enum": ["json", "console"]
        }
      }
    },
    "MetricsConfig": {
      "type": "object",
      "description": "Prometheus metrics endpoint (dependency-free text exposition).",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Expose metrics.",
          "default": false
        },
        "path": {
          "type": "string",
          "description": "Path, mounted outside base_url like /health.",
          "default": "/metrics"
        },
        "token": {
          "type": "string",
          "description": "Bearer token required to scrape. Use ${ENV_VAR}."
        }
      }
    },
    "CORSConfig": {
      "type": "object",
      "description": "CORS tuning beyond allowed_origins.",
      "additionalProperties": false,
      "properties": {
        "allowed_headers": {
          "type": "array",
          "description": "Request headers allowed cross-origin. Default: Authorization, Content-Type, Accept, X-API-Key, X-Request-ID, If-Match, Idempotency-Key.",
          "items": { "type": "string" }
        },
        "allowed_methods": {
          "type": "array",
          "description": "Methods allowed cross-origin. Default: GET, POST, PUT, PATCH, DELETE, OPTIONS.",
          "items": { "type": "string" }
        },
        "exposed_headers": {
          "type": "array",
          "description": "Response headers readable by browser JavaScript (e.g. ETag, X-Request-ID).",
          "items": { "type": "string" }
        },
        "max_age": {
          "type": "integer",
          "description": "Preflight cache seconds.",
          "default": 600
        }
      }
    },
    "SMTPConfig": {
      "type": "object",
      "description": "Outgoing email for email triggers, password reset and verification. Empty fields fall back to SMTP_* env vars.",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "description": "SMTP server host (env: SMTP_HOST)."
        },
        "port": {
          "type": "integer",
          "description": "SMTP port (env: SMTP_PORT).",
          "default": 587
        },
        "username": {
          "type": "string",
          "description": "SMTP username (env: SMTP_USER)."
        },
        "password": {
          "type": "string",
          "description": "SMTP password; use ${ENV_VAR} (env: SMTP_PASS)."
        },
        "from_name": {
          "type": "string",
          "description": "Display name in From (env: SMTP_SENDER_NAME)."
        },
        "from_email": {
          "type": "string",
          "description": "Sender address (env: SMTP_SENDER_EMAIL)."
        },
        "retry": {
          "type": "object",
          "description": "Delivery retry policy.",
          "additionalProperties": false,
          "properties": {
            "max_attempts": {
              "type": "integer",
              "description": "Total attempts before the message is marked dead."
            },
            "backoff": {
              "type": "string",
              "description": "exponential (default) or fixed.",
              "enum": ["exponential", "fixed"]
            },
            "initial_delay": {
              "type": "string",
              "description": "Delay before the first retry, e.g. 10s."
            },
            "max_delay": {
              "type": "string",
              "description": "Cap on the delay between retries, e.g. 1h."
            }
          }
        }
      }
    },
    "OutboxConfig": {
      "type": "object",
      "description": "Webhook/email delivery worker.",
      "additionalProperties": false,
      "properties": {
        "poll_interval": {
          "type": "string",
          "description": "How often due messages are picked up.",
          "default": "1s"
        },
        "retention": {
          "type": "string",
          "description": "Delivered messages are deleted after this (supports d, e.g. 7d).",
          "default": "7d"
        }
      }
    },
    "CronConfig": {
      "type": "object",
      "description": "Job scheduling across replicas.",
      "additionalProperties": false,
      "properties": {
        "distributed": {
          "type": "boolean",
          "description": "Coordinate runs through yaypi_job_locks so each tick runs on one replica (needs a database).",
          "default": true
        }
      }
    },
    "AuditConfig": {
      "type": "object",
      "description": "Audit log (entities with audit: true).",
      "additionalProperties": false,
      "properties": {
        "retention": {
          "type": "string",
          "description": "Delete audit rows older than this, e.g. 365d. Default: keep forever."
        }
      }
    }
  }
}
